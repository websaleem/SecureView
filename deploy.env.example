# Deployment identifiers for scripts/deploy-backend.sh and
# scripts/teardown-legacy.sh.
#
# Copy to `deploy.env` and fill in. `deploy.env` is gitignored: none of these
# are secrets, but together they name the AWS account and the exact CloudFront
# distributions this project deploys to. Publishing that makes an attacker's
# reconnaissance free — account ids are the starting point for bucket-name
# enumeration and role-name guessing — so they stay out of the public tree.
#
#   cp deploy.env.example deploy.env && $EDITOR deploy.env

# AWS account the scripts are allowed to touch. teardown-legacy.sh refuses to
# run anywhere else; that guard is the reason it is required rather than
# optional.
SECUREVIEW_ACCOUNT_ID=

# CloudFront distributions that already hold the aliases and certificates, which
# deploy-backend.sh adopts rather than recreating.
SECUREVIEW_PROD_DISTRIBUTION_ID=
SECUREVIEW_DEV_DISTRIBUTION_ID=

# Origin Access Control ids for the site S3 origins on those distributions.
SECUREVIEW_PROD_OAC_ID=
SECUREVIEW_DEV_OAC_ID=

# ACM certificate (us-east-1) covering the prod alias. The wildcard
# *.secureview.websaleem.com covers dev but NOT the apex, so prod needs its own.
SECUREVIEW_CERT_ARN=
